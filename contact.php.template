<?php
/**
 * Winmark Ingredients - Secure Contact Form Handler
 * Version: 1.1.0
 * 
 * Features:
 * - Honeypot Spam Prevention
 * - CORS & Origin Protection (CSRF Mitigation)
 * - Email Header Injection Protection
 * - Robust Input Validation & Sanitization
 */

// 1. CORS & SECURITY HEADERS
// Set this to your actual production domain for maximum security
$allowed_origin = "https://winmarkingredients.com"; 

header("Access-Control-Allow-Origin: $allowed_origin");
header("Access-Control-Allow-Methods: POST, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type");
header("Content-Type: application/json; charset=UTF-8");
header("X-Content-Type-Options: nosniff");

// Handle preflight OPTIONS requests
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit;
}

// Only allow POST requests
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(["status" => "error", "message" => "Method Not Allowed"]);
    exit;
}

// 2. READ & DECODE INPUT
$input = file_get_contents('php://input');
$data = json_decode($input, true);

if (!$data) {
    http_response_code(400);
    echo json_encode(["status" => "error", "message" => "Invalid JSON payload"]);
    exit;
}

// 3. HONEYPOT VALIDATION
if (!empty($data['website'])) {
    // Silently reject by returning success to the bot
    echo json_encode(["status" => "success", "message" => "Inquiry received."]);
    exit;
}

// 4. INPUT SANITIZATION & VALIDATION
// Use htmlspecialchars and filter_var to prevent XSS and malformed data
$first_name   = htmlspecialchars(strip_tags(trim($data['firstName'] ?? '')), ENT_QUOTES, 'UTF-8');
$last_name    = htmlspecialchars(strip_tags(trim($data['lastName'] ?? '')), ENT_QUOTES, 'UTF-8');
$email        = filter_var(trim($data['email'] ?? ''), FILTER_SANITIZE_EMAIL);
$company      = htmlspecialchars(strip_tags(trim($data['companyName'] ?? '')), ENT_QUOTES, 'UTF-8');
$inquiry_type = htmlspecialchars(strip_tags(trim($data['inquiryType'] ?? '')), ENT_QUOTES, 'UTF-8');
$message      = htmlspecialchars(strip_tags(trim($data['message'] ?? '')), ENT_QUOTES, 'UTF-8');

// Validate Required Fields
if (empty($first_name) || empty($last_name) || empty($email) || empty($message)) {
    http_response_code(422);
    echo json_encode(["status" => "error", "message" => "Missing required fields."]);
    exit;
}

// Validate Email Format
if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
    http_response_code(422);
    echo json_encode(["status" => "error", "message" => "Invalid email address format."]);
    exit;
}

// 5. EMAIL PREPARATION (PREVENT HEADER INJECTION)
/**
 * We strip newlines from values that will go into the mail headers
 * to prevent attackers from injecting "Bcc:" or "Cc:" fields.
 */
function clean_header($data) {
    return str_replace(["\r", "\n", "%0a", "%0d"], '', $data);
}

$to = "info@winmarkingredients.com"; // Your receiving email
$subject = "New Industrial Inquiry: " . clean_header($inquiry_type);

// Build the Message Body
$email_body = "--- Winmark Portal Inquiry ---\n\n";
$email_body .= "From: $first_name $last_name\n";
$email_body .= "Email: $email\n";
$email_body .= "Company: $company\n";
$email_body .= "Type: $inquiry_type\n\n";
$email_body .= "Message:\n$message\n\n";
$email_body .= "--- End of Message ---\n";
$email_body .= "Sent from IP: " . $_SERVER['REMOTE_ADDR'];

// Secure Headers
$headers = [
    "From" => "Winmark Portal <noreply@winmarkingredients.com>",
    "Reply-To" => clean_header($first_name . " " . $last_name) . " <" . clean_header($email) . ">",
    "X-Mailer" => "PHP/" . phpversion()
];

// 6. SEND EMAIL
// Use the -f flag in the 5th parameter to set the envelope sender (prevents SPF failures)
$mail_sent = mail($to, $subject, $email_body, $headers, "-f noreply@winmarkingredients.com");

if ($mail_sent) {
    echo json_encode(["status" => "success", "message" => "Email sent successfully."]);
} else {
    http_response_code(500);
    echo json_encode(["status" => "error", "message" => "Internal Server Error: Mail delivery failed."]);
}
